{
  "version": 2,
  "builds": [
    { "src": "api/index.php", "use": "vercel-php@0.8.0" },
    { "src": "public/css/**", "use": "@vercel/static" },
    { "src": "public/js/**", "use": "@vercel/static" },
    { "src": "public/fonts/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/(css|js|fonts)/(.*)", "dest": "/public/$1/$2" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
